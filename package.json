{
  "name": "openwhispr-mcp",
  "version": "0.2.0",
  "description": "Local MCP server exposing OpenWhispr notes, folders, transcripts and dictionary over the app's CLI bridge",
  "type": "module",
  "license": "MIT",
  "author": "dezer32",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dezer32/openwhispr-mcp.git"
  },
  "homepage": "https://github.com/dezer32/openwhispr-mcp#readme",
  "bugs": {
    "url": "https://github.com/dezer32/openwhispr-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "openwhispr",
    "claude",
    "transcription",
    "notes",
    "dictation"
  ],
  "bin": {
    "openwhispr-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
